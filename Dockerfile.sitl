# ArduPilot ArduCopter SITL, built once from a pinned release tag.
ARG ARDUPILOT_REF=Copter-4.6.3

FROM ubuntu:24.04 AS build
ARG ARDUPILOT_REF
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates build-essential python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv && /venv/bin/pip install --no-cache-dir empy==3.3.4 pexpect future "setuptools<81" lxml pymavlink
ENV PATH="/venv/bin:${PATH}"
RUN git clone --depth 1 --branch "${ARDUPILOT_REF}" --recurse-submodules --shallow-submodules \
        https://github.com/ArduPilot/ardupilot.git /ardupilot
WORKDIR /ardupilot
RUN python3 ./waf configure --board sitl && python3 ./waf copter -j"$(nproc)"

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10002 --create-home --shell /usr/sbin/nologin sitl
COPY --from=build /ardupilot/build/sitl/bin/arducopter /usr/local/bin/arducopter
COPY --from=build /ardupilot/Tools/autotest/default_params/copter.parm /opt/copter.parm
USER 10002
WORKDIR /home/sitl
CMD ["arducopter", "--model", "+", "--speedup", "1", "--home", "48.137,11.575,520,0", \
     "--defaults", "/opt/copter.parm", "--sim-address=127.0.0.1", "-I0"]
